// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Users {
  userId     Int          @id(map: "users_pkey") @default(autoincrement()) @map("user_id")
  email      VarChar(255) @unique(map: "users_email_key")
  fullName   VarChar(255) @map("full_name")
  createdAt  Timestamp?   @default(now()) @map("created_at")
  hashedPass VarChar(255) @map("hashed_pass")
  carts      Carts?
  orders     Orders[]

  @@map("users")
}

model Carts {
  cartId    Int         @id(map: "carts_pkey") @default(autoincrement()) @map("cart_id")
  userId    Int         @unique(map: "carts_user_id_key") @map("user_id")
  cartItems CartItems[]
  user      Users       @relation(fields: [userId], references: [userId], map: "carts_user_id_fkey")

  @@map("carts")
}

model Products {
  productId     Int            @id(map: "products_pkey") @default(autoincrement()) @map("product_id")
  name          VarChar(255)
  description   String?
  imageUrl      VarChar(255)?  @map("image_url")
  price         Numeric(10, 2)
  stockQuantity Int            @map("stock_quantity")
  cartItems     CartItems[]
  orderItems    OrderItems[]

  @@map("products")
}

model CartItems {
  cartItemId Int      @id(map: "cart_items_pkey") @default(autoincrement()) @map("cart_item_id")
  quantity   Int
  cartId     Int      @map("cart_id")
  productId  Int      @map("product_id")
  cart       Carts    @relation(fields: [cartId], references: [cartId], map: "cart_items_cart_id_fkey", index: false)
  product    Products @relation(fields: [productId], references: [productId], map: "cart_items_product_id_fkey", index: false)

  @@unique([cartId, productId], map: "cart_items_cart_id_product_id_key")
  @@map("cart_items")
}

model Orders {
  orderId         Int          @id(map: "orders_pkey") @default(autoincrement()) @map("order_id")
  status          VarChar(20)
  userId          Int          @map("user_id")
  createdAt       Timestamp?   @default(now()) @map("created_at")
  customerName    VarChar(255) @map("customer_name")
  customerPhone   VarChar(10)  @map("customer_phone")
  customerAddress VarChar(255) @map("customer_address")
  totalProduct    Int          @map("total_product")
  orderItems      OrderItems[]
  user            Users        @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "orders_user_id_fkey", index: false)

  @@check(expression: "((status)::text = ANY ((ARRAY['pending'::character varying, 'processing'::character varying, 'shipping'::character varying, 'completed'::character varying, 'cancelled'::character varying])::text[]))", map: "orders_status_check")
  @@map("orders")
}

model OrderItems {
  quantity  Int
  price     Numeric(10, 2)
  orderId   Int            @map("order_id")
  productId Int            @map("product_id")
  order     Orders         @relation(fields: [orderId], references: [orderId], map: "order_items_order_id_fkey", index: false)
  product   Products       @relation(fields: [productId], references: [productId], map: "order_items_product_id_fkey", index: false)

  @@id([orderId, productId], map: "order_items_pkey")
  @@check(expression: "(quantity > 0)", map: "order_items_quantity_check")
  @@map("order_items")
}
